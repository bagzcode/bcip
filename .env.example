# BCIP local development environment
# Copy this file to .env:
#
#   cp .env.example .env
#
# Never commit .env or real production credentials.

NODE_ENV=development

# ============================================================
# Application
# ============================================================

APP_URL=http://localhost:3000


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=bcip
POSTGRES_USER=bcip
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql://bcip:change-me@localhost:5433/bcip


# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://localhost:6379/0


# ============================================================
# S3 / MinIO
# ============================================================

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

S3_BUCKET_PRIVATE=bcip-private
S3_BUCKET_PUBLIC=bcip-public

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-change-me

S3_FORCE_PATH_STYLE=true


# ============================================================
# Authentication
# ============================================================

BETTER_AUTH_SECRET=replace-with-random-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000


# ============================================================
# AI Service
# ============================================================

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-me

# Local development uses the mock provider.
AI_PROVIDER=mock


# ============================================================
# OpenTelemetry
# ============================================================

OTEL_SERVICE_NAME=bcip-web

# Leave empty when no local OTLP collector is configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
