# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

POSTGRES_DB=bcip
POSTGRES_USER=bcip
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bcip:change-me@localhost:5433/bcip
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=bcip-private
S3_BUCKET_PUBLIC=bcip-public
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-change-me
S3_FORCE_PATH_STYLE=true

BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-me
AI_PROVIDER=mock

OTEL_SERVICE_NAME=bcip-web
OTEL_EXPORTER_OTLP_ENDPOINT=
